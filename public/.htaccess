Options -MultiViews +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route everything that is not a real file/directory through the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Deny access to sensitive file types
<FilesMatch "\.(sql|log|md|txt|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
