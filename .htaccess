# This directory is NOT the web root.
# On cPanel, point your domain/subdomain document root to the "public/" folder.
# Direct web access to this directory should be denied by the server configuration.

# Deny all direct web access as a safety net
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
