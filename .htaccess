<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve real files/directories directly (favicon.ico, robots.txt, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Forward everything else through public/index.php
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Protect sensitive files from direct download
<FilesMatch "\.(sql|log|env|md|txt|gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
