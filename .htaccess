Options -MultiViews +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve real static files directly (e.g. files already in project root)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Map /assets/* requests to public/assets/* (assets live inside public/)
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Route everything else through the front controller
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Protect sensitive files from direct download
<FilesMatch "\.(sql|log|env|md|txt|gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
