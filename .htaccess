<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve real files directly (assets, favicon.ico, robots.txt, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route everything else (including directories) through the front controller
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Protect sensitive files from direct download
<FilesMatch "\.(sql|log|env|md|txt|gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
